<div class="<%= wrapper_classes %>">
  <table class="<%= table_element_classes %>">
    <% if @caption %>
      <caption class="<%= caption_classes %>"><%= @caption %></caption>
    <% end %>

    <% if collection_mode? %>
      <%# Collection mode rendering %>
      <% if columns.any? %>
        <% if header_partial? %>
          <thead class="<%= thead_classes %>">
            <%= render partial: @header_partial, locals: { columns: columns } %>
          </thead>
        <% else %>
          <thead class="<%= thead_classes %>">
            <tr>
              <% columns.each do |column| %>
                <th class="<%= collection_header_cell_classes(column) %>" scope="col">
                  <% if column.sortable && collection_sort_link?(column) %>
                    <%= link_to collection_sort_url(column), **collection_sort_link_html(column), class: "flex items-center gap-1 no-underline text-inherit" do %>
                      <%= column.display_label %>
                      <span class="<%= collection_sort_icon_classes(column) %>"><%= raw collection_sort_icon(column) %></span>
                    <% end %>
                  <% elsif column.sortable %>
                    <span class="flex items-center gap-1">
                      <%= column.display_label %>
                      <span class="<%= collection_sort_icon_classes(column) %>"><%= raw collection_sort_icon(column) %></span>
                    </span>
                  <% else %>
                    <%= column.display_label %>
                  <% end %>
                </th>
              <% end %>
            </tr>
          </thead>
        <% end %>
      <% end %>

      <% if @collection.any? %>
        <tbody class="<%= tbody_classes %>">
          <% @collection.each_with_index do |item, index| %>
            <% if body_row_partial? %>
              <%= render partial: @body_row_partial, locals: { item: item, index: index, columns: columns } %>
            <% else %>
              <%= tag.tr(**collection_row_attributes(item, index)) do %>
                <% columns.each do |column| %>
                  <td class="<%= collection_cell_classes(column) %>"><%= column.value_for(item) %></td>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      <% elsif empty_state? %>
        <tbody>
          <tr>
            <td colspan="<%= columns.size %>"><%= empty_state %></td>
          </tr>
        </tbody>
      <% end %>

      <% if footer_partial? %>
        <tfoot class="<%= tfoot_classes %>">
          <%= render partial: @footer_partial, locals: { collection: @collection, columns: columns } %>
        </tfoot>
      <% end %>
    <% else %>
      <%# Slot mode rendering %>
      <% if header? %>
        <thead class="<%= thead_classes %>">
          <%= header %>
        </thead>
      <% end %>

      <% if rows.any? %>
        <tbody class="<%= tbody_classes %>">
          <% rows.each do |row| %>
            <%= row %>
          <% end %>
        </tbody>
      <% elsif empty_state? %>
        <tbody>
          <tr>
            <td colspan="<%= slot_mode_colspan %>"><%= empty_state %></td>
          </tr>
        </tbody>
      <% end %>

      <% if footer_row? %>
        <tfoot class="<%= tfoot_classes %>">
          <%= footer_row %>
        </tfoot>
      <% end %>
    <% end %>
  </table>
</div>
