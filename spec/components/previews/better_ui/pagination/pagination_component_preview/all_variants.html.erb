<div class="p-8 space-y-8">
  <% (@variants || BetterUi::ApplicationComponent::VARIANTS.keys).each do |variant| %>
    <div>
      <h3 class="text-lg font-semibold mb-3 capitalize"><%= variant %></h3>
      <%= render BetterUi::Pagination::PaginationComponent.new(
        current_page: 5,
        total_pages: 20,
        url: ->(page) { "#page-#{page}" },
        variant: variant
      ) %>
    </div>
  <% end %>
</div>
