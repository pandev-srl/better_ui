<div class="p-8 space-y-8">
  <% (@styles || [:solid, :outline, :ghost, :soft]).each do |style| %>
    <div>
      <h3 class="text-lg font-semibold mb-3 capitalize"><%= style %></h3>
      <%= render BetterUi::Pagination::PaginationComponent.new(
        current_page: 5,
        total_pages: 20,
        url: ->(page) { "#page-#{page}" },
        style: style
      ) %>
    </div>
  <% end %>
</div>
