<div class="p-8">
  <h3 class="text-lg font-semibold mb-6">Progress Sizes</h3>

  <div class="space-y-6 max-w-lg">
    <% (@sizes || [:xs, :sm, :md, :lg]).each do |size| %>
      <div class="flex items-center gap-4">
        <span class="w-12 text-sm font-medium text-gray-600 uppercase"><%= size %></span>

        <div class="flex-1">
          <%= render BetterUi::ProgressComponent.new(value: 60, size: size, variant: :primary) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
